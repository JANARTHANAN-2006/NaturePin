<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NaturePin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light_green</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="android:windowBackground">@color/background_white</item>
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="GreenEditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="hintTextColor">@color/primary_green</item>
    </style>

    <style name="GreenButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>
